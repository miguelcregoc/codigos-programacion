package intro;



class Pajaro{ //*** atributos o propiedades ****
	private char color; //propiedad o atributo color
	private int edad; //propiedad o atributo edad
	
	//contructor POR DEFECTO sin parametros
	
	//*** métodos de la clase ****
	public void setedad(int e){
		edad = e;
		}	
	public void printedad(){
		System.out.println("la edad del pajaro es: "+edad);
		}
	public void setcolor(char c){
		color=c;
		}
	public void printcolor(){
	switch(color){
	//Los pájaros son verdes, amarillos, grises, negros o blancos
	//No existen pájaros de otros colores
	case 'v': System.out.println("el pajaro es verde");break;
	case 'a': System.out.println("el pajaro es amarillo");break;
	case 'g': System.out.println("el pajaro es gris");break;
	case 'n': System.out.println("el pajaro es negro");break;
	case 'b': System.out.println("el pajaro es blanco");break;
	default: System.out.println("color no establecido");
	}
	}
}
