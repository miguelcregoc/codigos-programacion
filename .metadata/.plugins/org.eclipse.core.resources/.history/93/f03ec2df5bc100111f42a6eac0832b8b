package intro;

import java.util.Scanner;

public class MetodosEstaticos {

	public static double KmMillas(double km) {
		double milla;
		milla = km/1.60934;
		return milla;
	}
	public static double MillasKm(double milla) {
		double km;
		km = milla*1.60934;
		return km;
	}
	public static void main(String[] args) {
		
		Scanner buscaminas = new Scanner(System.in);
		System.out.println("Millas-Km(0) Km-Millas(1) o Salir (2)?");
		int pregunta, milla, km; 
		do {
			pregunta = buscaminas.nextInt();
			switch(pregunta){
			case 0: 
				System.out.println("Dame las millas: ");
				milla = buscaminas.nextInt();
				System.out.println("En Km: "+MillasKm(milla));
				break;
			case 1:
				System.out.println("Dame las Km: ");
				km = buscaminas.nextInt();
				System.out.println("En millas: "+KmMillas(km));
				break;
			case 2:
				System.out.println("Chao");
				break;
			default: System.out.println("dame otro entero");
			}
			
			
			
		} while(pregunta!=2);

		buscaminas.close();
		
	}
}
