package ejercicios1;

import java.util.Random;

public class Propuesto8 {
/*Realiza un programa que genere letras aleatoriamente y determine si son vocales o
consonantes.*/
	public static char dameNumEntero() {
		Random aleatorio = new Random();
		int letra = aleatorio.nextInt(26)+65;
		return (char) letra;
		}
	
	public static void main(String[] args) {
		String vocales = "aeiou";
		char letra = dameNumEntero();
		letra = Character.toLowerCase(letra);
		System.out.println(letra);
		int indice = vocales.indexOf(letra);	/* SUPER IMPORTANTE 
			.indexOf funciona de la siguiente manera: 
			1.- le meto el String (en este caso vocales) antes del . del metodo: Este va a ser el String que va a escanear
			2.- dentro de los parentesis del metodo meto el int o char a evaluar, en este caso letra
			3.- lo que me va a dar va a ser un int. Si el char a evaluar esta dentro de ese String da la posicion donde se encuentra,
			si no da -1
			4.- esa evaluacion la guardo en indice*/
		System.out.println(indice); 
		if(indice != -1) { //si indice es -1 entonces no es vocal
			System.out.println("Vocal");
		}else System.out.println("Consonante");
	}
}
