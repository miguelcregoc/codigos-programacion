package intro;

import java.util.Scanner;

public class DolaresEur {

	public static double EurDol(double eur) {
		double dol = 0;
		dol = eur*1.12;
		return dol;
	}
	public static double DolEur(double dol) {
		double eur;
		eur = dol/1.12;
		return eur;
	}
	public static void main(String[] args) {
		
		Scanner buscaminas = new Scanner(System.in);
		System.out.println("Euro-Dolar(0) Dolar-Euro(1) o Salir (2)?");
		int pregunta; 
		double eur, dol;
		do {
			pregunta = buscaminas.nextInt();
			switch(pregunta){
			case 0: 
				System.out.println("Dame los Euros: ");
				eur = buscaminas.nextDouble();
				System.out.println("En Dolars: "+EurDol(eur));
				break;
			case 1:
				System.out.println("Dame los Dolars: ");
				dol = buscaminas.nextDouble();
				System.out.println("En Euros: "+DolEur(dol));
				break;
			case 2:
				System.out.println("Chao");
				break;
			default: System.out.println("numero no valido, intentalo de nuevo");
			}
			
			
			
		} while(pregunta!=2&&pregunta!=1&&pregunta!=0);

		buscaminas.close();
		
	}
}