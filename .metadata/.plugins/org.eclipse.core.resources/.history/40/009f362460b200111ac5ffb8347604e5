package paquete;

import java.util.Scanner;

public class Ejemplo5 {

	// dame los n primeros multiplos de 2
	public static void main(String[] args) {
		Scanner buscaminas = new Scanner(System.in);
		System.out.println("Cuantos multiplos de 2 quieres? ");
		int n = buscaminas.nextInt();
		
		// i variable contador
		//n numero de veces q se repite el bucle
		for (int i = 0; i<n; i++) {

			System.out.println(i + "	multplo de 2: " + 2*i);

		}
		
		buscaminas.close();
	}

}
